{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask House (uv)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "app",
        "FLASK_DEBUG": "1",
        "DATABASE_URL": "sqlite:///app.db",
        "FLASK_SECRET_KEY": "dev-secret"
      },
      "args": [
        "run",
        "--host",
        "0.0.0.0",
        "--port",
        "8005"
      ],
      "jinja": true
    }
  ]
}
